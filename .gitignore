# Dependencies
node_modules/

# Build output
dist/
coverage/
*.tsbuildinfo
# The HTML entry of every language but the default one is generated from src/i18n/site-copy.ts by
# vite/locale-entries.ts. Each generated directory carries its own .gitignore, so adding a
# language needs no line here.

# Data: the upstream files (data/raw/) are committed; the datasets built from them are not, since
# `npm run dev` and `npm run build` rebuild them (see README.md → "Data").
public/data/
# Except these: 4-5 MB of archive apiece for one translation is not worth keeping in the
# repository, so the build downloads them on demand and checks each against its pin in
# data/sources.json.
data/raw/eng-kjv2006_vpl.zip
data/raw/deu1912_vpl.zip
data/raw/ita1927_vpl.zip
data/raw/spavbl_vpl.zip
data/raw/polubg_vpl.zip
# And these: 96 MB of tagged Hebrew and Greek, which STEPBible asks to be fetched from them
# rather than passed on second-hand. The build downloads them against their pins too.
data/raw/stepbible-*.txt

# Test output: Playwright's traces, screenshots and report, and the Vitest cache.
test-results/
playwright-report/
.vitest/

# Logs
*.log
npm-debug.log*

# Local environment
*.local
.env
.env.*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
